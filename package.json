{
  "name": "counterexample",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.10.1",
  "type": "module",
  "description": "Executable product promises and reproducible billing counterexamples",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm build && node --env-file-if-exists=.env --watch src/server.ts",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "demo": "node src/demo.ts",
    "submission:evidence": "node scripts/submission-evidence.ts",
    "verify:vercel": "node scripts/verify-vercel-build.mjs",
    "verify:vercel:browser": "node scripts/verify-vercel-browser.mjs",
    "repository": "node src/repository-cli.ts",
    "repair": "node --env-file-if-exists=.env src/repair-cli.ts",
    "test:sandbox": "COUNTEREXAMPLE_TEST_DOCKER=true vitest run tests/docker-sandbox.test.ts tests/repair-flow.test.ts tests/repair-web-docker.test.ts tests/submission-packet-docker.test.ts tests/hosted-quota-docker.test.ts",
    "test": "pnpm build && vitest run tests",
    "test:e2e": "pnpm build && playwright test",
    "audit:ui": "pnpm build && node scripts/audit.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hono/node-server": "^1.19.0",
    "hono": "^4.10.0",
    "ky": "^1.10.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.2.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "lighthouse": "^13.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}
